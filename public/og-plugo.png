<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0B0B10;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a1a2e;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>
  
  <!-- Grid pattern -->
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#28F27E" stroke-width="1" opacity="0.1"/>
    </pattern>
  </defs>
  <rect width="1200" height="630" fill="url(#grid)"/>
  
  <!-- Logo -->
  <g transform="translate(100, 200)">
    <!-- PLUGO Text -->
    <text x="0" y="0" font-family="Arial, sans-serif" font-size="72" font-weight="bold" fill="#F4F6F8">
      PLUGO
    </text>
    
    <!-- Accent line -->
    <rect x="0" y="10" width="200" height="4" fill="#28F27E"/>
    
    <!-- Tagline -->
    <text x="0" y="60" font-family="Arial, sans-serif" font-size="24" fill="#F4F6F8" opacity="0.8">
      Campus Power Bank Network
    </text>
    
    <!-- Subtitle -->
    <text x="0" y="90" font-family="Arial, sans-serif" font-size="18" fill="#28F27E">
      Borrow. Charge. Return. Repeat.
    </text>
  </g>
  
  <!-- Battery icon -->
  <g transform="translate(800, 150)">
    <rect x="0" y="0" width="120" height="60" rx="8" fill="none" stroke="#28F27E" stroke-width="3"/>
    <rect x="120" y="20" width="15" height="20" fill="#28F27E"/>
    <rect x="10" y="10" width="80" height="40" rx="4" fill="#28F27E" opacity="0.3"/>
    <rect x="10" y="10" width="60" height="40" rx="4" fill="#28F27E"/>
  </g>
</svg>